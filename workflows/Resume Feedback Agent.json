        "jsonBody": "={{\n  {\n    contents: [\n      {\n        parts: [\n          {\n            text: \"Analyze this student resume for placement readiness.\\n\\nReturn ONLY valid JSON with these fields: atsScore, strengths, weaknesses, missingSkills, suggestions, overallFeedback.\\n\\nResume:\\n\" + $json.text\n          }\n        ]\n      }\n    ]\n  }\n}}",
