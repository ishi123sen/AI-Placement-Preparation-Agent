    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $json.candidates[0].content.parts[0].text;\n\nconst cleaned = response\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst analysis = JSON.parse(cleaned);\n\nreturn {\n  json: {\n    ...analysis,\n    studentEmail: $('Extract from File').first().json.text.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i)?.[0] || ''\n  }\n};"
